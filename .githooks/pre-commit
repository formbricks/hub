#!/bin/bash

# Git pre-commit hook to enforce code formatting and linting
# This hook runs before each commit to ensure code quality

set -e

# Add Go bin directories to PATH (git hooks run in minimal environment)
export PATH="$HOME/go/bin:${GOPATH:-$HOME/go}/bin:$PATH"

echo "Running pre-commit checks..."

# Renames and deletions count when deciding what to validate: removing or moving a
# .go file can break the build just as easily as editing one. They are excluded
# from STAGED_GO_FILES further down, which only auto-stages formatter fixes and so
# genuinely wants files that still exist.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMRD)

# The Go toolchain stages below are pointless for a commit that touches no Go
# code — docs/ is an Astro site and the only non-Go part of the repo. Mirrors the
# path filters on tests.yml and code-quality.yml so local and CI agree on what a
# change is worth checking.
STAGED_GO_RELEVANT=$(echo "$STAGED_FILES" | grep -E '\.go$|^go\.(mod|sum)$|^Makefile$|^\.golangci\.yml$' || true)

# Validate migrations if any staged file is in migrations/
STAGED_MIGRATIONS=$(echo "$STAGED_FILES" | grep '^migrations/' || true)
if [ -n "$STAGED_MIGRATIONS" ]; then
    echo "Validating migration files..."
    if ! command -v goose >/dev/null 2>&1; then
        echo "Error: goose not found. Install it with: make install-tools"
        exit 1
    fi
    if ! make migrate-validate; then
        echo ""
        echo "❌ Migration validation failed. Fix the errors above before committing."
        exit 1
    fi
fi

if [ -z "$STAGED_GO_RELEVANT" ]; then
    echo "No Go changes staged — skipping fmt, lint and unit tests."
    if echo "$STAGED_FILES" | grep -q '^docs/'; then
        echo "Docs changed: validate with 'pnpm check' and 'pnpm build' from docs/ (also enforced by docs-build.yml)."
    fi
    echo "✅ Pre-commit checks passed!"
    exit 0
fi

# Check if golangci-lint is installed
if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "Error: golangci-lint not found. Install it with: make install-tools"
    exit 1
fi

# Format code (make fmt = gofumpt + gci via golangci-lint --fix from .golangci.yml)
# Keep track of staged Go files so we only auto-stage fixes for those files. Unlike
# STAGED_FILES this deliberately re-queries with ACM: a formatter fix can only be
# staged for a file that still exists.
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
echo "Running make fmt..."
if ! make fmt; then
    echo ""
    echo "❌ Format failed. Fix the errors above, then run: git add -u && git commit"
    exit 1
fi

# Stage only auto-fixed files that were already staged.
if [ -n "$STAGED_GO_FILES" ]; then
    FIXED_FILES=""
    for file in $STAGED_GO_FILES; do
        if git diff --name-only -- "$file" | grep -q .; then
            git add -- "$file"
            FIXED_FILES="${FIXED_FILES}${FIXED_FILES:+$'\n'}${file}"
        fi
    done
    if [ -n "$FIXED_FILES" ]; then
        echo "Staging auto-fixed files..."
        echo "$FIXED_FILES" | sed 's/^/    /'
    fi
fi

# Verify no remaining issues
echo "Running linter..."
if ! make lint; then
    echo ""
    echo "❌ Linting failed. Please fix the errors above before committing."
    exit 1
fi

# Fast unit tests (no DB); coverage is enforced in CI only
echo "Running unit tests..."
if ! make test-unit; then
    echo ""
    echo "❌ Unit tests failed. Fix the errors above before committing."
    exit 1
fi

echo "✅ Pre-commit checks passed!"
exit 0
